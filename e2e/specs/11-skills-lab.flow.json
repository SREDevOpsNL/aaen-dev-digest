{
  "name": "Skills Lab navigation, skill cards, preview, Add menu and delete confirmations",
  "description": "Read-only: checks the SKILLS LAB sidebar section, opens a seeded skill card's side preview and its Open details link, opens the Add skill menu and the Create dialog (with its Markdown body field) without submitting, and dismisses the skill and agent delete confirmations with Cancel and X. Nothing is created or deleted, and no model is called.",
  "steps": [
    { "cmd": ["open", "{BASE}/skills"], "label": "load the Skills page" },
    { "cmd": ["wait", "--url", "/skills"], "label": "skills route reached" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "skills fetch settles" },
    { "cmd": ["wait", "--text", "SKILLS LAB"], "label": "sidebar has a SKILLS LAB section" },
    { "cmd": ["eval", "(() => { const t = document.body.innerText; const lab = t.indexOf('SKILLS LAB'); return lab > t.indexOf('WORKSPACE') && t.indexOf('Conventions', lab) > lab && t.indexOf('Agents', lab) > lab && t.indexOf('Skills', lab) > lab; })()"], "assert": { "stdoutIncludes": "true" }, "label": "Conventions, Agents and Skills sit under SKILLS LAB" },
    { "cmd": ["wait", "--text", "Behavioral Coverage"], "label": "seeded skill card is visible" },
    { "cmd": ["find", "role", "button", "click", "--name", "Preview skill Behavioral Coverage"], "label": "click the skill card" },
    { "cmd": ["wait", "--text", "Open details"], "label": "side preview opens" },
    { "cmd": ["wait", "--url", "/skills"], "label": "preview did not leave the Skills page" },
    { "cmd": ["find", "role", "button", "click", "--name", "Open details"], "label": "open the full skill page" },
    { "cmd": ["wait", "--url", "tab=config"], "label": "skill detail page reached" },
    { "cmd": ["wait", "--text", "Versions"], "label": "detail tabs render" },
    { "cmd": ["open", "{BASE}/skills"], "label": "back to the Skills page" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "skills fetch settles again" },
    { "cmd": ["find", "role", "button", "click", "--name", "Add skill"], "label": "open the Add skill menu" },
    { "cmd": ["wait", "--text", "From a Markdown file"], "label": "menu offers Import" },
    { "cmd": ["find", "text", "Write a new skill", "click"], "label": "choose Create" },
    { "cmd": ["wait", "--text", "Create a skill"], "label": "create dialog opens" },
    { "cmd": ["wait", "--text", "Skill body (Markdown)"], "label": "create dialog has a Markdown body field" },
    { "cmd": ["find", "role", "button", "click", "--name", "Close"], "label": "dismiss the create dialog without saving" },
    { "cmd": ["wait", "--fn", "!document.querySelector('[role=dialog]')"], "label": "create dialog closed" },
    { "cmd": ["find", "role", "button", "click", "--name", "Delete skill Behavioral Coverage"], "label": "ask to delete a skill" },
    { "cmd": ["wait", "--text", "Delete skill “Behavioral Coverage”?"], "label": "skill delete confirmation opens" },
    { "cmd": ["find", "role", "button", "click", "--name", "Cancel"], "label": "cancel the skill deletion" },
    { "cmd": ["wait", "--fn", "!document.querySelector('[role=dialog]')"], "label": "confirmation closed by Cancel" },
    { "cmd": ["find", "role", "button", "click", "--name", "Delete skill Behavioral Coverage"], "label": "ask again" },
    { "cmd": ["find", "role", "button", "click", "--name", "Close"], "label": "dismiss with X" },
    { "cmd": ["wait", "--fn", "!document.querySelector('[role=dialog]')"], "label": "confirmation closed by X" },
    { "cmd": ["wait", "--text", "Behavioral Coverage"], "label": "the skill is still there" },
    { "cmd": ["open", "{BASE}/agents"], "label": "load the Agents page" },
    { "cmd": ["wait", "--load", "networkidle"], "label": "agents fetch settles" },
    { "cmd": ["find", "role", "button", "click", "--name", "Delete agent Security Reviewer"], "label": "ask to delete an agent" },
    { "cmd": ["wait", "--text", "This cannot be undone."], "label": "agent delete confirmation opens" },
    { "cmd": ["find", "role", "button", "click", "--name", "Cancel"], "label": "cancel the agent deletion" },
    { "cmd": ["wait", "--fn", "!document.querySelector('[role=dialog]')"], "label": "agent confirmation closed by Cancel" },
    { "cmd": ["find", "role", "button", "click", "--name", "Delete agent Security Reviewer"], "label": "ask again" },
    { "cmd": ["find", "role", "button", "click", "--name", "Close"], "label": "dismiss with X" },
    { "cmd": ["wait", "--fn", "!document.querySelector('[role=dialog]')"], "label": "agent confirmation closed by X" },
    { "cmd": ["wait", "--text", "Security Reviewer"], "label": "the agent is still there" }
  ]
}
